{
  "realm": "parley",
  "displayName": "Parley testbed",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "ssoSessionIdleTimeout": 28800,
  "ssoSessionMaxLifespan": 43200,
  "accessTokenLifespan": 300,
  "accessTokenLifespanForImplicitFlow": 300,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "oauth2DevicePollingInterval": 5,
  "oauth2DeviceCodeLifespan": 600,
  "groups": [
    { "name": "parley-users", "path": "/parley-users" },
    { "name": "reviewers", "path": "/reviewers" },
    { "name": "maintainers", "path": "/maintainers" },
    { "name": "security", "path": "/security" }
  ],
  "clients": [
    {
      "clientId": "parley-cli",
      "name": "Parley channel plugin (laptop login)",
      "description": "Public client for the plugin's OIDC login: authorization code with PKCE S256, loopback redirect, refresh tokens. Decision T4: the access token carries audience parley.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": false,
      "fullScopeAllowed": true,
      "redirectUris": ["http://127.0.0.1:5557/callback"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "use.refresh.tokens": "true",
        "oauth2.device.authorization.grant.enabled": "false",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "parley audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "parley",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "lightweight.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "lightweight.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "parley-headless",
      "name": "Parley headless agent (device flow, phase 4)",
      "description": "Public client for Claude Code running in a container without a browser. Device authorization grant only.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": false,
      "fullScopeAllowed": true,
      "redirectUris": [],
      "webOrigins": [],
      "attributes": {
        "oauth2.device.authorization.grant.enabled": "true",
        "use.refresh.tokens": "true"
      },
      "protocolMappers": [
        {
          "name": "parley audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "parley",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "gitlab",
      "name": "GitLab (single sign-on)",
      "description": "Confidential client used by GitLab's openid_connect provider. The secret comes from the environment variable KC_GITLAB_CLIENT_SECRET at import time and must equal the value gitlab.rb reads.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KC_GITLAB_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": false,
      "fullScopeAllowed": true,
      "redirectUris": ["https://gitlab.parleylab.dev/users/auth/openid_connect/callback"],
      "webOrigins": ["https://gitlab.parleylab.dev"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://gitlab.parleylab.dev/*"
      }
    }
  ],
  "users": [
    {
      "username": "alice",
      "email": "alice@parleylab.dev",
      "firstName": "Alice",
      "lastName": "Reviewer",
      "enabled": true,
      "emailVerified": true,
      "groups": ["/parley-users", "/reviewers", "/maintainers"]
    },
    {
      "username": "bob",
      "email": "bob@parleylab.dev",
      "firstName": "Bob",
      "lastName": "Author",
      "enabled": true,
      "emailVerified": true,
      "groups": ["/parley-users"]
    },
    {
      "username": "carol",
      "email": "carol@parleylab.dev",
      "firstName": "Carol",
      "lastName": "Reviewer",
      "enabled": true,
      "emailVerified": true,
      "groups": ["/parley-users", "/reviewers", "/maintainers", "/security"]
    },
    {
      "username": "dave",
      "email": "dave@parleylab.dev",
      "firstName": "Dave",
      "lastName": "Member",
      "enabled": true,
      "emailVerified": true,
      "groups": ["/parley-users"]
    },
    {
      "username": "erin",
      "email": "erin@parleylab.dev",
      "firstName": "Erin",
      "lastName": "Outsider",
      "enabled": true,
      "emailVerified": true,
      "groups": ["/parley-users"]
    },
    {
      "username": "mallory",
      "email": "mallory@parleylab.dev",
      "firstName": "Mallory",
      "lastName": "Nogroup",
      "enabled": true,
      "emailVerified": true,
      "groups": []
    }
  ]
}
