# Copy to deploy/cloud/.env on the host and fill every value. The .env file is
# never committed. Generate secrets with: openssl rand -base64 24

# Let's Encrypt account email (expiry notices go here).
ACME_EMAIL=you@example.com

# Keycloak bootstrap admin (created on first start only, realm master).
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me

# Password of the Keycloak database user (postgres container keycloak-db).
KC_DB_PASSWORD=change-me

# Secret of the confidential client `gitlab` in realm `parley`. Substituted
# into the realm on import and read by gitlab.rb; the two must stay equal.
KC_GITLAB_CLIENT_SECRET=change-me

# GitLab root password, applied on the first boot only.
GITLAB_ROOT_PASSWORD=change-me

# Inbox: round cap per task (testbed default 5) and service senders.
AIC_MAX_ROUNDS=5
AIC_SERVICE_USERS=promoter@parleylab.dev
