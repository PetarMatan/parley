{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aic.local/schema/note.v1.json",
  "title": "note.v1",
  "description": "Outcome summary appended to the merge request.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "context_id", "body"],
  "properties": {
    "schema": { "const": "note.v1", "pii-classification": "no-pii" },
    "context_id": {
      "type": "string", "maxLength": 256,
      "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*![1-9][0-9]{0,9}$",
      "pii-classification": "no-pii"
    },
    "body": { "type": "string", "minLength": 1, "maxLength": 8000, "description": "Markdown", "pii-classification": "no-pii" }
  }
}
