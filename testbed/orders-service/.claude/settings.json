{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PARLEY_ROOT/plugin/hooks/session-start.mjs\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PARLEY_ROOT/plugin/hooks/session-end.mjs\""
          }
        ]
      }
    ],
    "CwdChanged": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PARLEY_ROOT/plugin/hooks/cwd-changed.mjs\""
          }
        ]
      }
    ]
  }
}
