diff --git a/internal/order/store.go b/internal/order/store.go
index 0cd67dc..a736eb1 100644
--- a/internal/order/store.go
+++ b/internal/order/store.go
@@ -33,13 +33,21 @@ func (s *Store) Create(r NewOrderRequest) (*Order, error) {
 	if err := Validate(r); err != nil {
 		return nil, err
 	}
+	lines := append([]Line(nil), r.Lines...)
+	for i := range lines {
+		// Quantities above the limit are capped; the warehouse splits large
+		// orders anyway.
+		if lines[i].Quantity > MaxQuantity {
+			lines[i].Quantity = MaxQuantity
+		}
+	}
 	s.mu.Lock()
 	defer s.mu.Unlock()
 	s.seq++
 	o := &Order{
 		ID:        fmt.Sprintf("ord-%06d", s.seq),
 		Customer:  strings.TrimSpace(r.Customer),
-		Lines:     append([]Line(nil), r.Lines...),
+		Lines:     lines,
 		Status:    StatusOpen,
 		CreatedAt: s.now().UTC(),
 	}
diff --git a/internal/order/store_test.go b/internal/order/store_test.go
index 500da35..08b4761 100644
--- a/internal/order/store_test.go
+++ b/internal/order/store_test.go
@@ -83,3 +83,13 @@ func TestCancelOnce(t *testing.T) {
 		t.Fatalf("unknown cancel: want ErrNotFound, got %v", err)
 	}
 }
+
+func TestCreateCapsQuantity(t *testing.T) {
+	s := NewStore()
+	r := validRequest()
+	r.Lines[0].Quantity = MaxQuantity + 500
+	o, err := s.Create(r)
+	if err != nil || o.Lines[0].Quantity != MaxQuantity {
+		t.Fatalf("want capped to %d, got %v %+v", MaxQuantity, err, o)
+	}
+}
