#!/usr/bin/env bash
# Starts B's Claude Code session in the quarantine __QDIR__ with a scrubbed
# environment. Generated by quarantine/make-quarantine.sh; do not edit.
set -euo pipefail
cd "__QDIR__"
keep=()
for v in PATH HOME USER LOGNAME SHELL TMPDIR TERM LANG CLAUDE_CONFIG_DIR; do
  if [[ -n "${!v:-}" ]]; then keep+=("$v=${!v}"); fi
done
# --settings carries sandbox.network.strictAllowlist, which Claude Code
# ignores in project settings files.
exec env -i ${keep[@]+"${keep[@]}"} AIC_WORK="__WORK__" AIC_CHECKOUT="__QDIR__" \
  claude --dangerously-load-development-channels plugin:parley@parley \
  --settings "__SESSION_SETTINGS__" "$@"
