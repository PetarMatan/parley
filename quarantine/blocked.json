{
  "source": "inbox/internal/rules/scan.go BlockedFiles (hand-mirrored; inbox/internal/promote tests fail when the two lists differ)",
  "globs": [
    ".gitlab-ci.yml",
    ".github/**",
    ".claude/**",
    ".mcp.json",
    "CLAUDE.md",
